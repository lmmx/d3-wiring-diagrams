{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "types": [],
    "paths": {
      "@codemirror/*": [
        "../site/node_modules/@codemirror/*"
      ],
      "@lezer/*": [
        "../site/node_modules/@lezer/*"
      ]
    }
  },
  "include": [
    "src/**/*.js",
    "../viewer/*.js"
  ]
}
